{
  "compilerOptions": {
    "module": "es6",
    "lib": [
      "es6"
    ],
    "target": "es2015",
    "moduleResolution": "Node",
    "baseUrl": "src/",
    "sourceMap": true,
    "outDir": "dist/",
    "rootDir": "./src",
    "inlineSources": true,
    // "inlineSourceMap": true,
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "removeComments": true,
    "experimentalDecorators": true,
    "noImplicitReturns": true,
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false,
    "esModuleInterop": true,
    // "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": [
      "./node_modules/@types",
      "./@types",
      "./node_modules/@types/screeps/dist"
    ],
    "paths": {
      "*": [
        "*",
        "shared/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
